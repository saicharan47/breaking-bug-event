{
  "rules": {
    ".read": false,
    ".write": false,
    "teams": {
      "$teamCode": {
        ".read": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
        "authUid": {
          ".read": "auth != null && data.val() === auth.uid",
          ".write": "auth != null && auth.provider === 'anonymous' && !data.exists() && newData.isString() && newData.val() === auth.uid && root.child('teamClaims').child($teamCode).child('uid').val() === auth.uid",
          ".validate": "newData.isString()"
        },
        "accessKey": {
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".validate": "newData.isString()"
        },
        "status": {
          ".read": "auth != null && data.parent().child('authUid').val() === auth.uid",
          ".write": "auth != null && auth.provider === 'anonymous' && data.parent().child('authUid').val() === auth.uid && newData.val() === 'submitted' && (data.val() === 'connected' || data.val() === 'in-progress') && !data.parent().child('submittedAt').exists()",
          ".validate": "newData.isString() && newData.val() === 'submitted'"
        },
        "connectedAt": {
          ".read": "auth != null && data.parent().child('authUid').val() === auth.uid",
          ".write": "auth != null && auth.provider === 'anonymous' && data.parent().child('authUid').val() === auth.uid && newData.isNumber()",
          ".validate": "newData.isNumber()"
        },
        "lastSeenAt": {
          ".read": "auth != null && data.parent().child('authUid').val() === auth.uid",
          ".write": "auth != null && auth.provider === 'anonymous' && data.parent().child('authUid').val() === auth.uid && newData.isNumber()",
          ".validate": "newData.isNumber()"
        },
        "answers": {
          ".read": "auth != null && data.parent().child('authUid').val() === auth.uid",
          "$questionId": {
            ".write": "auth != null && auth.provider === 'anonymous' && data.parent().parent().child('authUid').val() === auth.uid && !data.exists() && root.child('competition').child('control').child('command').val() in ['phase1-start','phase1-resume'] && root.child('competition').child('control').child('phase1StartedAt').isNumber() && root.child('competition').child('control').child('phase1DurationSeconds').isNumber() && now < root.child('competition').child('control').child('phase1StartedAt').val() + root.child('competition').child('control').child('phase1DurationSeconds').val() * 1000 && newData.isString() && newData.val().matches(/^[A-D]$/)",
            ".validate": "newData.isString() && newData.val().matches(/^[A-D]$/)"
          }
        },
        "advanced": {
          ".read": "auth != null && data.parent().child('authUid').val() === auth.uid",
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".validate": "newData.isBoolean()"
        },
        "recovery": {
          ".read": "auth != null && data.parent().child('authUid').val() === auth.uid",
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".validate": "newData.isNumber()"
        },
        "corruption": {
          ".read": "auth != null && data.parent().child('authUid').val() === auth.uid",
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".validate": "newData.isNumber()"
        },
        "integrity": {
          ".read": "auth != null && data.parent().child('authUid').val() === auth.uid",
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".validate": "newData.isNumber()"
        },
        "netScore": {
          ".read": "auth != null && data.parent().child('authUid').val() === auth.uid",
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".validate": "newData.isNumber()"
        },
        "totalTimeSeconds": {
          ".read": "auth != null && data.parent().child('authUid').val() === auth.uid",
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".validate": "newData.isNumber()"
        },
        "submittedAt": {
          ".read": "auth != null && data.parent().child('authUid').val() === auth.uid",
          ".write": "auth != null && auth.provider === 'anonymous' && data.parent().child('authUid').val() === auth.uid && !data.exists() && newData.isNumber()",
          ".validate": "newData.isNumber()"
        },
        "phase1StartedAt": {
          ".read": "auth != null && data.parent().child('authUid').val() === auth.uid",
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".validate": "newData.isNumber()"
        },
        "questionOrder": {
          ".read": "auth != null && data.parent().child('authUid').val() === auth.uid",
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".validate": "newData.hasChildren()"
        },
        "runId": {
          ".read": "auth != null && data.parent().child('authUid').val() === auth.uid",
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".validate": "newData.isString()"
        },
        "$other": {
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'"
        }
      }
    },
    "teamClaims": {
      "$teamCode": {
        ".read": false,
        ".write": "auth != null && ((auth.provider === 'anonymous' && !data.exists() && newData.hasChildren(['uid','accessKey']) && newData.child('uid').val() === auth.uid && newData.child('accessKey').val() === root.child('teams').child($teamCode).child('accessKey').val()) || (data.child('uid').val() === auth.uid && !newData.exists()))",
        ".validate": "newData.hasChildren(['uid', 'accessKey']) && newData.child('uid').isString() && newData.child('accessKey').isString()"
      }
    },
    "competition": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'"
    },
    "rounds": {
      ".read": false,
      ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
      "$round": {
        ".read": false,
        ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
        "publicQuestions": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'"
        },
        "config": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'"
        },
        "questions": {
          ".read": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'"
        }
      }
    }
  }
}
