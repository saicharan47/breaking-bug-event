{
  "rules": {
    ".read": false,
    ".write": false,
    "teams": {
      "$teamCode": {
        ".read": "auth != null && (auth.token.email === 'saicharan.ak477@gmail.com' || data.child('authUid').val() === auth.uid)",
        "authUid": {
          ".write": "auth != null && auth.provider === 'anonymous' && !data.exists() && newData.isString() && newData.val() === auth.uid && root.child('teamClaims').child($teamCode).child('uid').val() === auth.uid",
          ".validate": "newData.isString()"
        },
        "accessKey": {
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".validate": "newData.isString()"
        },
        "answers": {
          "$questionId": {
            ".write": "auth != null && auth.provider === 'anonymous' && data.parent().parent().child('authUid').val() === auth.uid && newData.isString() && newData.val().matches(/^[A-D]$/)",
            ".validate": "newData.isString() && newData.val().matches(/^[A-D]$/)"
          }
        },
        "connectedAt": {
          ".write": "auth != null && auth.provider === 'anonymous' && data.parent().child('authUid').val() === auth.uid",
          ".validate": "newData.isNumber()"
        },
        "lastSeenAt": {
          ".write": "auth != null && auth.provider === 'anonymous' && data.parent().child('authUid').val() === auth.uid",
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".write": "auth != null && auth.provider === 'anonymous' && data.parent().child('authUid').val() === auth.uid && ((data.val() === 'connected' && newData.val() === 'in-progress') || (data.val() === 'in-progress' && newData.val() === 'submitted') || (data.val() === 'connected' && newData.val() === 'submitted'))",
          ".validate": "newData.isString() && (newData.val() === 'connected' || newData.val() === 'in-progress' || newData.val() === 'submitted')"
        },
        "submittedAt": {
          ".write": "auth != null && auth.provider === 'anonymous' && data.parent().child('authUid').val() === auth.uid && !data.exists()",
          ".validate": "newData.isNumber()"
        },
        "questionOrder": {
          ".write": "auth != null && auth.provider === 'anonymous' && data.parent().child('authUid').val() === auth.uid",
          ".validate": "newData.hasChildren()"
        },
        "runId": {
          ".write": "auth != null && auth.provider === 'anonymous' && data.parent().child('authUid').val() === auth.uid",
          ".validate": "newData.isString()"
        },
        "phase1StartedAt": {
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".validate": "newData.isNumber()"
        },
        "recovery": {
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".validate": "newData.isNumber()"
        },
        "corruption": {
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".validate": "newData.isNumber()"
        },
        "integrity": {
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".validate": "newData.isNumber()"
        },
        "netScore": {
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".validate": "newData.isNumber()"
        },
        "advanced": {
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'"
        }
      }
    },
    "teamClaims": {
      "$teamCode": {
        ".read": "auth != null && (auth.token.email === 'saicharan.ak477@gmail.com' || data.child('uid').val() === auth.uid)",
        ".write": "auth != null && ((auth.provider === 'anonymous' && !data.exists() && newData.child('uid').val() === auth.uid && newData.child('accessKey').val() === root.child('teams').child($teamCode).child('accessKey').val()) || (data.child('uid').val() === auth.uid && !newData.exists()))",
        ".validate": "newData.hasChildren(['uid', 'accessKey']) && newData.child('uid').isString() && newData.child('accessKey').isString()"
      }
    },
    "competition": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'"
    },
    "rounds": {
      ".read": false,
      ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
      "$round": {
        ".read": false,
        ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
        "publicQuestions": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'"
        },
        "config": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'"
        },
        "questions": {
          ".read": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'",
          ".write": "auth != null && auth.token.email === 'saicharan.ak477@gmail.com'"
        }
      }
    }
  }
}
